.:53 {
    errors
    health :8080
    ready :8181
    forward . /etc/resolv.conf
    cache 30
    log
}

# Split-DNS zone handed to tailnet clients by headscale (see ../config.yaml).
# Answers *.proxy.patinanetwork.org directly with traefik-internal's own
# tailnet IP (it's a tailnet node too - see its sidecar in ../traefik-internal).
proxy.patinanetwork.org:53 {
    errors
    log
    template IN A proxy.patinanetwork.org {
        match "^(?P<sub>.+)\.proxy\.patinanetwork\.org\.$"
        # TODO: replace with traefik-internal's real tailnet IP once its
        # sidecar has joined (`headscale nodes list`, hostname
        # "traefik-internal") - this is a one-time value, it won't change
        # again since that node's identity is persisted on a PVC.
        answer "{{ .Name }} 60 IN A 100.64.0.99"
        fallthrough
    }
    forward . /etc/resolv.conf
    cache 30
}
